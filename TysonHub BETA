panel.Size = UDim2.fromOffset(260, 210)
panel.Position = UDim2.fromScale(0.4, 0.35)
panel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
panel.BorderSizePixel = 0
panel.Parent = gui

Instance.new("UICorner", panel).CornerRadius = UDim.new(0.05, 0)
Instance.new("UIStroke", panel).Thickness = 2

---------------------------------------------------
-- TITLE
---------------------------------------------------
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
title.Text = "TYSON HUB"
title.Font = FONT
title.TextSize = 16
title.TextColor3 = Color3.new(1,1,1)
title.BorderSizePixel = 0
title.Parent = panel

---------------------------------------------------
-- DRAGGING
---------------------------------------------------
local dragging, dragStart, startPos

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = panel.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		panel.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

---------------------------------------------------
-- TOGGLE CREATOR
---------------------------------------------------
local function createToggle(text, yPos, default)
	local label = Instance.new("TextLabel")
	label.Text = text
	label.Font = FONT
	label.TextSize = 14
	label.TextColor3 = Color3.new(1,1,1)
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(12, yPos)
	label.Size = UDim2.fromOffset(140, 24)
	label.Parent = panel

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(24, 24)
	btn.Position = UDim2.fromOffset(210, yPos)
	btn.BackgroundColor3 = default and Color3.fromRGB(0,200,0) or Color3.fromRGB(200,0,0)
	btn.Text = ""
	btn.Parent = panel

	Instance.new("UICorner", btn)
	return btn
end

