-- SERVICES
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer

---------------------------------------------------
-- SETTINGS (LIVE)
---------------------------------------------------
local ESP_ENABLED = true
local SHOW_NAMES = true
local SHOW_DISTANCE = false
local MAX_DISTANCE = 150

local BAR_OFFSET = Vector3.new(0, 3.5, 0)
local NAME_OFFSET = Vector3.new(0, 4.25, 0)
local DIST_OFFSET = Vector3.new(0, -3.2, 0)

local BAR_SIZE = UDim2.fromScale(6, 0.55) -- thinner bar
local FONT = Enum.Font.GothamBold
local TWEEN_TIME = 0.12

-- TEXT READABILITY SETTINGS
local NAME_TEXT_SIZE = 18
local DIST_TEXT_SIZE = 16
local MAX_READABLE_DISTANCE = 300

---------------------------------------------------
-- STORAGE
---------------------------------------------------
local bars = {}

---------------------------------------------------
-- SCREEN GUI
---------------------------------------------------
