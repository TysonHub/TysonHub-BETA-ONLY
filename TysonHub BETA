---------------------------------------------------
-- ESP CREATION
---------------------------------------------------
local function createESP(player, character)
	if player == localPlayer or bars[player] then return end

	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")

	-- OUTLINE
	local highlight = Instance.new("Highlight")
	highlight.Adornee = character
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0.3
	highlight.OutlineColor = Color3.new(1,1,1)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	-- NAME
	local nameGui = Instance.new("BillboardGui")
	nameGui.Adornee = root
	nameGui.Size = UDim2.fromScale(6, 0.6)
	nameGui.StudsOffsetWorldSpace = NAME_OFFSET
	nameGui.AlwaysOnTop = true
	nameGui.Parent = root

	local nameText = Instance.new("TextLabel", nameGui)
	nameText.Size = UDim2.fromScale(1,1)
	nameText.BackgroundTransparency = 1
	nameText.Font = FONT
	nameText.TextScaled = false
	nameText.TextSize = NAME_TEXT_SIZE
	nameText.TextWrapped = false
	nameText.TextColor3 = Color3.new(1,1,1)
	nameText.TextStrokeTransparency = 0
	nameGui.SizeOffset = Vector2.new(0, 0)
	nameGui.Size = UDim2.fromOffset(180, 24)

	-- HEALTH BAR
	local barGui = Instance.new("BillboardGui")
	barGui.Adornee = root
	barGui.Size = BAR_SIZE
	barGui.StudsOffsetWorldSpace = BAR_OFFSET
	barGui.AlwaysOnTop = true
	barGui.Parent = root

	local bg = Instance.new("Frame", barGui)
	bg.Size = UDim2.fromScale(1,1)
	bg.BackgroundColor3 = Color3.fromRGB(20,20,20)

	local bar = Instance.new("Frame", bg)
	bar.Size = UDim2.fromScale(1,1)
	bar.BackgroundColor3 = Color3.fromRGB(0,255,0)

	local hpText = Instance.new("TextLabel", bg)
	hpText.Size = UDim2.fromScale(1,1)
	hpText.BackgroundTransparency = 1
	hpText.Font = FONT
	hpText.TextScaled = true
	hpText.TextColor3 = Color3.new(1,1,1)
	hpText.TextStrokeTransparency = 0

	local pad = Instance.new("UIPadding", hpText)
	pad.PaddingLeft = UDim.new(0,6)
	pad.PaddingRight = UDim.new(0,6)

	-- DISTANCE
	local distGui = Instance.new("BillboardGui")
	distGui.Adornee = root
	distGui.Size = UDim2.fromScale(4, 0.5)
	distGui.StudsOffsetWorldSpace = DIST_OFFSET
	distGui.AlwaysOnTop = true
	distGui.Parent = root

	local distText = Instance.new("TextLabel", distGui)
	distText.Size = UDim2.fromScale(1,1)
	distText.BackgroundTransparency = 1
	distText.Font = FONT
	distText.TextScaled = false
	distText.TextSize = DIST_TEXT_SIZE
	distText.TextWrapped = false
	distText.TextColor3 = Color3.fromRGB(200,200,200)
	distText.TextStrokeTransparency = 0
	distGui.SizeOffset = Vector2.new(0, 0)
	distGui.Size = UDim2.fromOffset(160, 22)

	bars[player] = {
		root = root,
		humanoid = humanoid,
		highlight = highlight,
		bar = bar,
		hpText = hpText,
		nameText = nameText,
		distText = distText,
		guis = {nameGui, barGui, distGui},
		lastHealth = humanoid.Health
	}
end

---------------------------------------------------
-- UPDATE LOOP
---------------------------------------------------
RunService.RenderStepped:Connect(function()
	local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localRoot then return end

	for _, d in pairs(bars) do
		local dist = (localRoot.Position - d.root.Position).Magnitude
		local show = ESP_ENABLED and dist <= MAX_DISTANCE

		for _, g in ipairs(d.guis) do
			g.Enabled = show
		end
		d.highlight.Enabled = show

		if not show then continue end

		local hp = math.floor(d.humanoid.Health)
		local max = math.floor(d.humanoid.MaxHealth)
		local pct = math.clamp(hp / max, 0, 1)

		d.nameText.Text = SHOW_NAMES and d.root.Parent.Name:upper() or ""
		d.hpText.Text = string.format("%d / %d (%d%%)", hp, max, pct * 100)
		d.distText.Text = SHOW_DISTANCE and string.format("[%d STUDS]", dist) or ""
		-- Improve text readability at distance
		local alpha = math.clamp(dist / MAX_READABLE_DISTANCE, 0, 1)
		local stroke = 0.2 + (alpha * 0.6)

		d.nameText.TextStrokeTransparency = stroke
		d.distText.TextStrokeTransparency = stroke

		if hp ~= d.lastHealth then
			d.lastHealth = hp
			TweenService:Create(
				d.bar,
				TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Size = UDim2.fromScale(pct, 1) }
			):Play()
		end
	end
end)

---------------------------------------------------
-- PLAYER HANDLING
---------------------------------------------------
for _, p in ipairs(Players:GetPlayers()) do
	if p ~= localPlayer then
		p.CharacterAdded:Connect(function(c) createESP(p, c) end)
		if p.Character then createESP(p, p.Character) end
	end
end
